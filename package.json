{
  "name": "container-commander",
  "version": "0.0.0",
  "private": true,
  "description": "One thing decides which Firefox container a tab opens in \u2014 once, at entry.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:leaks": "node scripts/leak-lint.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "ci": "npm run lint && npm run lint:leaks && npm run format:check && npm run test"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.8.0",
    "vitest": "^4.1.0",
    "@eslint/js": "^10.0.0"
  }
}
