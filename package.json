{
  "name": "container-commander",
  "version": "0.4.0",
  "private": true,
  "description": "One thing decides which Firefox container a tab opens in \u2014 once, at entry.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:leaks": "node scripts/leak-lint.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "ci": "npm run lint && npm run lint:leaks && npm run format:check && npm run test:coverage && npm run package",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "icons": "node scripts/make-icons.mjs",
    "art": "bash scripts/make-art.sh",
    "amo:art": "node scripts/amo-art.mjs",
    "policy:check": "node scripts/check-policy.mjs",
    "policy:build": "node scripts/build-policy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.0",
    "vitest": "^4.1.0"
  }
}
